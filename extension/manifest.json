{
  "manifest_version": 3,
  "name": "Learning Child",
  "version": "0.0.3",
  "description": "Shows parent-curated videos on YouTube instead of algorithmic recommendations.",
  "action": { "default_title": "VibeCare Kids settings" },
  "background": { "service_worker": "background.js" },
  "options_page": "settings.html",
  "side_panel": { "default_path": "onboarding.html" },
  "permissions": ["storage", "alarms", "sidePanel"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://kids.vibecare.io/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["seed-catalog.json"],
      "matches": ["https://www.youtube.com/*"]
    }
  ]
}
